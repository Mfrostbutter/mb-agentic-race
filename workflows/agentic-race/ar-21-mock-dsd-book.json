  "nodes": [
    {
      "parameters": {
        "content": "## Mock DSD Book\nFive endpoints under ar-mock/dsd/*. Slots are deterministic per dealer and date. A slotId containing FULL returns 409. Bookings persist in ar_mock_bookings.",
        "width": 768,
        "height": 160,
        "color": 7
      },
      "id": "99ace694-5b3b-5732-a903-a11c7a03b95a",
      "name": "Sticky1",
      "type": "n8n-nodes-base.stickyNote",
