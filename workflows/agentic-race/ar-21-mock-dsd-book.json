        0,
        -400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ar-mock/dsd/dealers",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "57dc9794-41ff-54e2-a75c-2c3072c083ce",
      "name": "ReceiveDealers",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "357ab72a-ab47-5647-aec8-18b3186c639f"
    },
    {
      "parameters": {
        "jsCode": "// Mock of GIS / DSD dealer search. Real build: Sirius DSD API or GIS.\nconst b = $json.body || {};\nconst all = [\n  { dealerId: 'PL-WAW-01', name: 'Mercedes-Benz Warszawa Okęcie', city: 'Warszawa', market: 'PL', dsdEnabled: true },\n  { dealerId: 'PL-WAW-02', name: 'Mercedes-Benz Warszawa Wola', city: 'Warszawa', market: 'PL', dsdEnabled: true },\n  { dealerId: 'PL-KRK-01', name: 'Mercedes-Benz Kraków', city: 'Kraków', market: 'PL', dsdEnabled: true },\n  { dealerId: 'PL-GDA-01', name: 'Mercedes-Benz Gdańsk', city: 'Gdańsk', market: 'PL', dsdEnabled: false },\n  { dealerId: 'ES-MAD-02', name: 'Mercedes-Benz Madrid Castellana', city: 'Madrid', market: 'ES', dsdEnabled: true },\n  { dealerId: 'ES-BCN-01', name: 'Mercedes-Benz Barcelona', city: 'Barcelona', market: 'ES', dsdEnabled: true },\n  { dealerId: 'DE-STR-01', name: 'Mercedes-Benz Niederlassung Stuttgart', city: 'Stuttgart', market: 'DE', dsdEnabled: true },\n  { dealerId: 'GB-LON-01', name: 'Mercedes-Benz of London West', city: 'London', market: 'GB', dsdEnabled: true }\n];\nconst market = String(b.market || '').toUpperCase();\nconst city = String(b.city || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nlet hits = all.filter(d => !market || d.market === market);\nif (b.dealerId) hits = hits.filter(d => d.dealerId === b.dealerId);\nif (city) hits = hits.filter(d => d.city.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').includes(city));\nreturn [{ json: { dealers: hits } }];"
      },
      "id": "4565c544-10c1-5407-b603-ab4e18e189c7",
      "name": "FilterDealers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
