      "name": "ReceiveSlots",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        200
      ],
      "webhookId": "0fb907f7-6ba2-5f3d-bcff-86850ea21769"
    },
    {
      "parameters": {
        "jsCode": "// Mock of DSD Book slot availability. Deterministic from dealerId and date so tests repeat.\nconst b = $json.body || {};\nconst dealerId = String(b.dealerId || '');\nconst names = { 'PL-WAW-01': 'Mercedes-Benz Warszawa Okęcie', 'PL-WAW-02': 'Mercedes-Benz Warszawa Wola', 'PL-KRK-01': 'Mercedes-Benz Kraków', 'ES-MAD-02': 'Mercedes-Benz Madrid Castellana', 'ES-BCN-01': 'Mercedes-Benz Barcelona', 'DE-STR-01': 'Mercedes-Benz Niederlassung Stuttgart', 'GB-LON-01': 'Mercedes-Benz of London West' };\nif (!names[dealerId]) return [{ json: { dealerId, dealerName: null, slots: [], reason: 'dealer_not_dsd_enabled' } }];\nlet from = new Date(b.fromDate || Date.now());\nif (isNaN(from.getTime())) from = new Date();\nfrom.setUTCHours(0, 0, 0, 0);\nconst seed = [...dealerId].reduce((a, ch) => a + ch.charCodeAt(0), 0);\nconst times = ['08:00', '10:30', '14:00'];\nconst slots = [];\nfor (let d = 1; d <= 10 && slots.length < 6; d++) {\n  const day = new Date(from.getTime() + d * 86400000);\n  if (day.getUTCDay() === 0) continue;\n  times.forEach((t, i) => { if ((seed + d + i) % 3 !== 0) slots.push({ slotId: `${dealerId}-${day.toISOString().slice(0,10).replace(/-/g,'')}-${t.replace(':','')}`, startsAt: `${day.toISOString().slice(0,10)}T${t}:00`, dealerId }); });\n}\nreturn [{ json: { dealerId, dealerName: names[dealerId], slots: slots.slice(0, 6) } }];"
      },
      "id": "91ffed50-ca81-5abb-b524-7fbde52959d4",
      "name": "GenerateSlots",
