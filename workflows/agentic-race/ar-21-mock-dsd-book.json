    {
      "parameters": {
        "jsCode": "// Mock of DSD Book booking. Idempotent on idempotencyKey; a slotId containing FULL simulates a slot taken in the meantime.\nconst b = $json.body || {};\nconst key = String(b.idempotencyKey || '');\nconst slotId = String(b.slotId || '');\nif (!key || !slotId || !b.dealerId) return [{ json: { conflict: false, invalid: true, message: 'slotId, dealerId and idempotencyKey are required' } }];\nif (/FULL/.test(slotId)) return [{ json: { conflict: true, message: 'slot no longer available' } }];\nlet h = 0; for (const ch of key) h = (h * 31 + ch.charCodeAt(0)) >>> 0;\nconst code = 'DSD-' + (h % 1000000).toString().padStart(6, '0');\nconst m = slotId.match(/-(\\d{8})-(\\d{4})$/);\nconst startsAt = m ? `${m[1].slice(0,4)}-${m[1].slice(4,6)}-${m[1].slice(6,8)}T${m[2].slice(0,2)}:${m[2].slice(2,4)}:00` : '';\nreturn [{ json: { conflict: false, invalid: false, bookingRef: key, confirmationCode: code, slotId, dealerId: b.dealerId, vin: b.vin || '', serviceType: b.serviceType || '', mobility: b.mobility || '', startsAt, status: 'booked', bookedAt: new Date().toISOString() } }];"
      },
      "id": "35b3ddad-2bb6-5951-a288-43cbe6a10290",
      "name": "ComputeBooking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        400
      ]
    },
