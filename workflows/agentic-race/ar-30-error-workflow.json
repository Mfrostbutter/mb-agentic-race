      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json;\nconst msg = String((e.execution && e.execution.error && e.execution.error.message) || '').slice(0, 300);\nreturn [{ json: { at: new Date().toISOString(), correlationId: '', sessionId: '', caseId: '', workflow: (e.workflow && e.workflow.name) || '', event: 'error', state: '', tool: (e.execution && e.execution.lastNodeExecuted) || '', latencyMs: 0, outcome: 'failed', errorCode: 'workflow_error', detail: msg + ' execution=' + ((e.execution && e.execution.id) || '') } }];"
      },
