    {
      "parameters": {
        "jsCode": "const s = $json;\nif (!s.sessionId) return [{ json: { found: false, statusCode: 404 } }];\nreturn [{ json: { found: true, statusCode: 200, correlationId: s.correlationId, sessionId: s.sessionId, caseId: s.caseId, state: s.state, intent: s.intent, handoffReason: s.handoffReason || null, handoffResult: s.handoffResult || null, summary: s.handoffSummary || '', dealer: s.dealerName || null, slotId: s.slotId || null, confirmationCode: s.confirmationCode || null, language: s.language, market: s.market, startedAt: s.startedAt, endedAt: s.endedAt || null } }];"
