      "parameters": {
        "jsCode": "const rows = [{\"kind\": \"intent\", \"code\": \"BOOK\", \"short\": \"B\", \"ccValue\": \"APPT_BOOK\", \"description\": \"New service appointment\"}, {\"kind\": \"intent\", \"code\": \"RESCHEDULE\", \"short\": \"R\", \"ccValue\": \"APPT_RESCHEDULE\", \"description\": \"Move an existing appointment\"}, {\"kind\": \"intent\", \"code\": \"CANCEL\", \"short\": \"C\", \"ccValue\": \"APPT_CANCEL\", \"description\": \"Cancel an existing appointment\"}, {\"kind\": \"intent\", \"code\": \"OTHER\", \"short\": \"O\", \"ccValue\": \"OTHER\", \"description\": \"Outside appointment booking\"}, {\"kind\": \"intent\", \"code\": \"UNKNOWN\", \"short\": \"U\", \"ccValue\": \"unknown\", \"description\": \"Intent not identified\"}, {\"kind\": \"reason\", \"code\": \"CALLER_REQUEST\", \"short\": \"CR\", \"ccValue\": \"CUSTOMER_REQUEST\", \"description\": \"Caller asked for a person\"}, {\"kind\": \"reason\", \"code\": \"SCENARIO_REQUIRES_AGENT\", \"short\": \"SA\", \"ccValue\": \"PROCESS\", \"description\": \"Non-bookable dealer, callback or out-of-scope request\"}, {\"kind\": \"reason\", \"code\": \"NOT_UNDERSTOOD\", \"short\": \"NU\", \"ccValue\": \"LOW_CONFIDENCE\", \"description\": \"Two consecutive turns not understood\"}, {\"kind\": \"reason\", \"code\": \"BACKEND_UNAVAILABLE\", \"short\": \"BU\", \"ccValue\": \"SYSTEM_ERROR\", \"description\": \"CRM, DealerBook or case system unavailable\"}, {\"kind\": \"reason\", \"code\": \"IDENTIFICATION_FAILED\", \"short\": \"IF\", \"ccValue\": \"IDENTIFICATION\", \"description\": \"Customer or vehicle could not be confirmed\"}, {\"kind\": \"reason\", \"code\": \"NO_SLOT\", \"short\": \"NS\", \"ccValue\": \"NO_AVAILABILITY\", \"description\": \"No acceptable slot found\"}, {\"kind\": \"reason\", \"code\": \"POLICY\", \"short\": \"PO\", \"ccValue\": \"CONSENT\", \"description\": \"Caller declined the assistant or a policy trigger fired\"}, {\"kind\": \"reason\", \"code\": \"PLATFORM_ERROR\", \"short\": \"PE\", \"ccValue\": \"SYSTEM_ERROR\", \"description\": \"Dialogue platform failure\"}];\nreturn rows.map(r => ({ json: r }));"
