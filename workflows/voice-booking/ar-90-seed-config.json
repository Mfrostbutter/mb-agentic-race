        "jsCode": "const rows = [{\"market\": \"PL\", \"languages\": \"pl,en\", \"defaultLanguage\": \"pl\", \"bookable\": true, \"disclosure_pl\": \"Dzień dobry, tu asystent cyfrowy serwisu. Ta rozmowa jest prowadzona przez sztuczną inteligencję. W każdej chwili mogą Państwo poprosić o rozmowę z konsultantem.\", \"disclosure_es\": \"\", \"disclosure_en\": \"Hello, this is the workshop's digital assistant. This conversation is handled by an artificial intelligence. You can ask for a human colleague at any time.\", \"disclosure_de\": \"\", \"handoverLine\": \"Łączę Państwa z konsultantem, proszę chwilę poczekać.\", \"closingLine\": \"Dziękuję za rozmowę. Do widzenia.\", \"confirmationChannels\": \"sms,email\", \"returnNumber\": \"sip:111102@cc.example\", \"slotWindowDays\": 14, \"maxSlotsOffered\": 3}, {\"market\": \"ES\", \"languages\": \"es,en\", \"defaultLanguage\": \"es\", \"bookable\": true, \"disclosure_pl\": \"\", \"disclosure_es\": \"Hola, le atiende el asistente digital del taller. Esta conversación la gestiona una inteligencia artificial. Puede pedir hablar con una persona en cualquier momento.\", \"disclosure_en\": \"Hello, this is the workshop's digital assistant. This conversation is handled by an artificial intelligence. You can ask for a human colleague at any time.\", \"disclosure_de\": \"\", \"handoverLine\": \"Le paso con un agente, un momento por favor.\", \"closingLine\": \"Gracias por su llamada. Adiós.\", \"confirmationChannels\": \"sms,email\", \"returnNumber\": \"sip:111102@cc.example\", \"slotWindowDays\": 14, \"maxSlotsOffered\": 3}, {\"market\": \"DE\", \"languages\": \"de,en\", \"defaultLanguage\": \"de\", \"bookable\": true, \"disclosure_pl\": \"\", \"disclosure_es\": \"\", \"disclosure_en\": \"Hello, this is the workshop's digital assistant. This conversation is handled by an artificial intelligence. You can ask for a human colleague at any time.\", \"disclosure_de\": \"Guten Tag, hier ist der digitale Assistent der Werkstatt. Dieses Gespräch wird von einer künstlichen Intelligenz geführt. Sie können jederzeit einen Mitarbeiter verlangen.\", \"handoverLine\": \"Ich verbinde Sie mit einem Mitarbeiter, einen Moment bitte.\", \"closingLine\": \"Vielen Dank für Ihren Anruf. Auf Wiederhören.\", \"confirmationChannels\": \"sms,email\", \"returnNumber\": \"sip:111102@cc.example\", \"slotWindowDays\": 14, \"maxSlotsOffered\": 3}, {\"market\": \"GB\", \"languages\": \"en\", \"defaultLanguage\": \"en\", \"bookable\": true, \"disclosure_pl\": \"\", \"disclosure_es\": \"\", \"disclosure_en\": \"Hello, this is the workshop's digital assistant. This conversation is handled by an artificial intelligence. You can ask for a human colleague at any time.\", \"disclosure_de\": \"\", \"handoverLine\": \"I am connecting you to a colleague, one moment please.\", \"closingLine\": \"Thank you for calling. Goodbye.\", \"confirmationChannels\": \"sms,email\", \"returnNumber\": \"sip:111102@cc.example\", \"slotWindowDays\": 14, \"maxSlotsOffered\": 3}];\nreturn rows.map(r => ({ json: r }));"
