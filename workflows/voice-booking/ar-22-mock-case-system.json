              "name": "status",
              "value": "={{ $json.body.status || (($json.body.op || 'create') === 'create' ? 'In Progress' : 'Closed') }}",
              "type": "string"
            },
            {
              "id": "658ece15-dec5-5a4d-8d74-d30a8db0cba7",
              "name": "subject",
              "value": "={{ $json.body.subject || 'Appointment booking via voice assistant' }}",
              "type": "string"
            },
            {
              "id": "6531678e-a374-5bfd-9506-b8d8e1d6be31",
              "name": "classification",
              "value": "={{ $json.body.classification || 'Appointment Booking' }}",
              "type": "string"
            },
            {
              "id": "c11378f8-e7b4-59ee-a16d-dff6e9375406",
              "name": "solution",
              "value": "={{ $json.body.solution || '' }}",
              "type": "string"
            },
            {
              "id": "daffa018-dbaf-5017-9075-e53db3d5815e",
              "name": "delegatedReason",
              "value": "={{ $json.body.delegatedReason || '' }}",
              "type": "string"
            },
            {
              "id": "e41a2ffd-43ad-57cc-9f45-a0482c8c70e0",
              "name": "openedAt",
              "value": "={{ ($json.body.op || 'create') === 'create' ? $now.toUTC().toISO() : ($json.body.openedAt || '') }}",
              "type": "string"
            },
            {
              "id": "11024354-b292-56fd-a90a-544310f2ef23",
              "name": "lastUpdate",
              "value": "={{ $now.toUTC().toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
