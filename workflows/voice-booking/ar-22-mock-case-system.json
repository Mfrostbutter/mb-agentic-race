              "type": "string"
            },
            {
              "id": "8a73d98b-8d70-56b9-9209-4c6b772de302",
              "name": "caseId",
              "value": "={{ (($json.body.op || 'create') === 'create' || !$json.body.caseId) ? 'CS-' + (10000000 + (parseInt($json.hash.slice(0, 8), 16) % 90000000)) : $json.body.caseId }}",
              "type": "string"
            },
            {
              "id": "87d3d456-d536-5818-9c97-5aabba4b749a",
