    {
      "parameters": {
        "jsCode": "const b = $('CallDealerBookBook').first().json; const v = $('ValidateSlot').first().json;\nreturn [{ json: { ok: true, confirmationCode: b.confirmationCode, bookingRef: b.bookingRef, when: v.slot.label, dealerName: v.slot.dealerName, serviceType: v.serviceType, mobility: v.mobility, note: 'Booked. Read the confirmation code back to the caller slowly and tell them a confirmation message will follow.' } }];"
      },
      "id": "30d9feb9-aae8-58ce-9d66-2bd4f31f2fa9",
      "name": "ReturnBooking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Shapes a failed HTTP call into the sub-workflow's error contract. No throw: the caller branches on ok.\nconst e = $json.error || {};\nconst text = JSON.stringify(e);\nconst conflict = /409/.test(text);\nreturn [{ json: { ok: false, error: conflict ? 'slot_taken' : 'backend_unavailable',\n  message: conflict ? 'That slot was taken in the meantime. Call FindSlots again and offer new options.' : 'The backend system is unavailable. Apologise once and hand the caller to an agent (BACKEND_UNAVAILABLE).',\n  detail: String(e.message || '').slice(0, 200) } }];"
      },
      "id": "8eeff2be-ae15-5648-84ab-18644b2c7935",
      "name": "ReturnBookError",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = { ...$json }; delete j.proceed; return [{ json: j }];"
      },
